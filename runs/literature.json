{
 "items": [
  {
   "id": "obs-tree",
   "where": "[BFT21] Obs. \"Logarithmic nimber in trees\"",
   "claim": "t(k) has 2^k vertices, root degree k, value *k (k ≤ 10)",
   "got": "t(8): 256 vertices, deg 8, *8; t(9): 512 vertices, deg 9, *9; t(10): 1024 vertices, deg 10, *10",
   "ok": true
  },
  {
   "id": "thm-reduction",
   "where": "[BFT21] Thm \"Complexity Separation\"",
   "claim": "r(G,s) = * if (G,s) ∈ P, and ∈ N \\ {*} if (G,s) ∈ N",
   "got": "1801 / 1801 positions (every digraph on ≤ 3 vertices, 400 random on 4; reduced graphs up to 88 vertices)",
   "ok": true
  },
  {
   "id": "lem-wrong-way",
   "where": "[BFT21] Lemma \"Wrong Way\"",
   "claim": "moving y → d gives *2 or *3",
   "got": "2364 / 2364 gadgets; values seen: *2, *3",
   "ok": true
  },
  {
   "id": "lem-correct-way",
   "where": "[BFT21] Lemma \"Correct Way\"",
   "claim": "d → y is * exactly when x → a is *",
   "got": "2364 / 2364 gadgets",
   "ok": true
  },
  {
   "id": "cor-prelude",
   "where": "[BFT21] Cor. (prelude gadget)",
   "claim": "with the prelude, start is * if s is *, else *2",
   "got": "1801 / 1801",
   "ok": true
  },
  {
   "id": "thm-bnb-random",
   "where": "[BFT21] Thm \"Following the Winning Way\"",
   "claim": "branch-and-bound equals the Grundy value on max-degree-3 graphs",
   "got": "200 / 200 random subcubic graphs, n = 12…28; n=12: 5.5 winnability tests vs 180 search nodes; n=16: 5.3 winnability tests vs 573 search nodes; n=20: 5.6 winnability tests vs 2042 search nodes; n=24: 5.3 winnability tests vs 5805 search nodes; n=28: 5.5 winnability tests vs 16887 search nodes",
   "ok": true
  },
  {
   "id": "cor-dual-triangulation",
   "where": "[BFT21] Cor. \"Alternation Paths\"",
   "claim": "duals of triangulations (cube, dodecahedron; also Petersen): branch-and-bound = exact",
   "got": "cube * (6 tests, 73 nodes); Petersen * (6 tests, 184 nodes); dodecahedron * (6 tests, 4390 nodes)",
   "ok": true
  },
  {
   "id": "fsu-play",
   "where": "[FSU93] / [BFT21] Thm \"A Matching-Based Characterization\"",
   "claim": "from a winning start, moving along a maximum matching never loses",
   "got": "162 / 162 random games (8–17 vertices, opponent random)",
   "ok": true
  },
  {
   "id": "thm-constructability",
   "where": "[BFT21] Thm \"Right Amount of Stars\"",
   "claim": "the token on N_n has value *n (construction as drawn)",
   "got": "n=4: *4, n=5: *5, n=6: *6, n=7: *7, n=8: *8, n=9: *9",
   "ok": true
  },
  {
   "id": "alg-1",
   "where": "[BFT21] Algorithm 1",
   "claim": "Algorithm 1 as printed yields *n at N_n",
   "got": "n=4: 0, n=5: *, n=6: *2, n=7: *, n=8: *2, n=9: *",
   "ok": false,
   "note": "Algorithm 1 never adds the edges N_i–M_i, N_i–P_i, the edge N_4–R_4 or a *3 tree on N_4; the figures and lemmas use all three"
  },
  {
   "id": "lem-grounded",
   "where": "[BFT21] Lemma \"Grounded\"",
   "claim": "N_k → R_k is a move to 0",
   "got": "80 / 80",
   "ok": true,
   "note": "construction as drawn, n = 8, all 32 sets of removed N vertices"
  },
  {
   "id": "lem-r-to-n",
   "where": "[BFT21] Lemma (R_p → N_p)",
   "claim": "R_k → N_k is a move to 0",
   "got": "80 / 80",
   "ok": true
  },
  {
   "id": "lem-skip2",
   "where": "[BFT21] Lemma \"Skip *2\"",
   "claim": "N_k → M_k is * iff no lower N is gone, else *3",
   "got": "64 / 64",
   "ok": true
  },
  {
   "id": "lem-skip1",
   "where": "[BFT21] Lemma \"Skip *\"",
   "claim": "N_k → P_k is *2 iff no lower N is gone, else *3",
   "got": "64 / 64",
   "ok": true
  },
  {
   "id": "lem-not1or2",
   "where": "[BFT21] Lemma (at least *4)",
   "claim": "with only higher N gone, N_k is at least *4",
   "got": "31 / 31",
   "ok": true
  },
  {
   "id": "lem-parity",
   "where": "[BFT21] Lemma \"Parity\"",
   "claim": "with a lower N gone, N_k is * or *2 by the parity of the N above the lowest gone",
   "got": "49 / 49",
   "ok": true
  },
  {
   "id": "thm-induction",
   "where": "[BFT21] Thm \"Right Amount of Stars\" (induction)",
   "claim": "with only higher N gone, N_k is *k",
   "got": "31 / 31",
   "ok": true
  }
